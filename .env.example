# Gemini API Key (Required for VLM evaluation & caption generation)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# AutoInsta Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=autoinsta_secret_change_me_in_production
CLIENT_API_KEY=autoinsta_device_secret_token_123

# Instagram Publishing (Mode: dry_run | instagrapi | meta_graph)
PUBLISH_MODE=dry_run

# Instagrapi Credentials (if PUBLISH_MODE=instagrapi)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Meta Graph API for Instagram / Facebook (if PUBLISH_MODE=meta_graph)
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# Emergency SOS & Dead Man's Switch
EMERGENCY_PHONE=+33600000000
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
EMERGENCY_WEBHOOK_URL=https://your-webhook-endpoint.com/sos

